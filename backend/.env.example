# Copy this file to .env and fill in values as needed.
# Nothing here is required to run the app - the weather/geocoding APIs
# (Open-Meteo + OpenStreetMap Nominatim) are free and keyless.

PORT=5000

# Optional: enables the "related YouTube videos" feature in /api/videos.
# Get a free key at https://console.cloud.google.com/apis/credentials
# (enable the "YouTube Data API v3"). Leave blank to skip this feature.
YOUTUBE_API_KEY= "AIzaSyCpucAq3LaEFBEnsT-UBAoMXk6G7CZ_NP4"
