# Copy this file to .env and fill in values as needed.
# Nothing here is required to run the app - the weather/geocoding APIs
# (Open-Meteo + OpenStreetMap Nominatim) are free and keyless.

PORT=5000

# Optional: the "related YouTube videos" feature in /api/videos works out of
# the box with no key (it uses a keyless fallback). Setting this makes it use
# the official YouTube Data API instead, which is more reliable long-term.
# Get a free key at https://console.cloud.google.com/apis/credentials
# (enable the "YouTube Data API v3").
YOUTUBE_API_KEY=
